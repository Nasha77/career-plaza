# Local AI for Career Plaza (only used by `npm run dev`; never by the public site).
#
# 1. Copy this file to .env.local  (it is git-ignored, so your key never reaches GitHub)
# 2. Get a free Gemini API key at https://aistudio.google.com  ("Get API key")
# 3. Paste it below and restart `npm run dev`
#
# Leave it empty to play with the scripted lines only.
GEMINI_API_KEY=

# Optional: change the model. Check the current free-tier models in AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
